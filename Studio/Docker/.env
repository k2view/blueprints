# System and ingress parameters
SOCKET="/var/run/docker.sock"
DOCKER_SUBNET="172.26.0.0/24"
PERSISTENT_DATA="./persistent-data"
INGRESS_SOCAT_IMAGE="docker.io/alpine/socat:latest"
INGRESS_TRAEFIK_IMAGE="docker.io/library/traefik:v3"
INGRESS_PULL_POLICY="always" # Use 'always' to ensure socat and Traefik are always up-to-date; Use 'never' for images loaded offline / with hardcoded version / custom URL
INGRESS_HTTP_PORT="80"
INGRESS_HTTPS_PORT="443"
INGRESS_API_PORT="8080"

# Applications images
FABRIC_IMAGE="docker.share.cloud.k2view.com/k2view-images/fabric-studio"
FABRIC_VERSION="8.5.3_37"
PG_IMAGE="docker.io/library/postgres:17"
CASS_IMAGE="docker.io/library/cassandra:4.1.8"

# Applications parameters
SPACE_RESTART_POLICY="unless-stopped" # Use 'no' to prevent Spaces from restarting after server/workstation reboot
FABRIC_UI_PORT="" # Leave blank to use a random port (recommended)
FABRIC_JDBC_PORT="" # Leave blank to use a random port (recommended)

# Space configuration
COMPOSE_PROFILES="studio" # Default Space Profile
MAX_HEAP="4G"
PROJECT_NAME="webstudio"
PROJECT_DIR="/opt/apps/fabric/workspace/project"
INI_CONFIG_UPDATE_FILE="/opt/apps/fabric/space.config"

# Postgres DB and credentials
POSTGRES_DB="postgres"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# Git Integration
GIT_REPO=""
GIT_BRANCH="main"
GIT_USERNAME=""
GIT_TOKEN=""
GIT_USE_HEADER_AUTH="false" # Use 'true' if your Git provider requires authentication using an HTTP header 'Authentication: Bearer $GIT_TOKEN', like BitBucket DataCenter
