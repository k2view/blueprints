{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "errorPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cloudfrontUrl": {
          "type": "string",
          "minLength": 1
        },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "enabled"
      ]
    },
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "internalLoadBalancer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "create": {
          "type": "boolean"
        },
        "crt": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      },
      "required": [
        "secretName",
        "create"
      ]
    },
    "tlsStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enabled",
        "name"
      ]
    },
    "traefik": {
      "type": "object"
    }
  }
}
